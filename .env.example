# Banco de dados (desenvolvimento local com Docker)
# Em producao (Vercel), configure com Neon pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/study_center?sslmode=disable

# Exemplo Neon pooler:
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT secrets — gere com: openssl rand -base64 64
ACCESS_TOKEN_SECRET=change_me_access_secret_very_long_and_random
REFRESH_TOKEN_SECRET=change_me_refresh_secret_very_long_and_random

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Vercel Blob (upload de imagens)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Resend (envio de e-mail de redefinicao de senha)
# Sem RESEND_API_KEY, o backend apenas loga o conteudo do e-mail no console.
# Modo sandbox (sem dominio verificado) so entrega para o proprio e-mail da conta Resend.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Lumora <onboarding@resend.dev>

# AbstractAPI (verificacao de existencia do e-mail no cadastro)
# Sem ABSTRACT_API_KEY, cai para uma checagem simples de registro MX do dominio.
ABSTRACT_API_KEY=your_abstractapi_key

# URL do frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Ambiente
NODE_ENV=development

# Playwright local
PLAYWRIGHT_BASE_URL=http://localhost:5173
